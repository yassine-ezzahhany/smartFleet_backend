# ===== Spring Boot Application =====
SPRING_APPLICATION_NAME=smartfleet-backend
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api

# ===== Database (Supabase PostgreSQL + PostGIS) =====
DB_URL=postgresql://user:password@db.supabase.co:5432/smartfleet
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# ===== Clerk Authentication =====
# Get these from https://dashboard.clerk.com
CLERK_ISSUER=https://your-instance.clerk.accounts.com
CLERK_AUDIENCE=https://your-api.example.com
CLERK_WEBHOOK_SECRET=whsec_xxx_your_webhook_secret_here

# ===== Valhalla Routing Service =====
VALHALLA_URL=http://localhost:8002

# ===== Firebase Cloud Messaging (optional) =====
# FIREBASE_CONFIG_PATH=path/to/firebase-config.json

# ===== Logging =====
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_MA_SMARTFLEET_BACKEND=DEBUG
